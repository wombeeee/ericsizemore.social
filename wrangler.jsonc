{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericsizemoresocial",
  "compatibility_date": "2026-04-11",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Invoke the Worker before serving static assets — required so the
    // ericsizemore.social → ericsizemore.tech redirect runs on page URLs,
    // not just non-asset paths. env.ASSETS.fetch still serves the files.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
